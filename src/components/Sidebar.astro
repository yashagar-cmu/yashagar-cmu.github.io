---
import Logo from "@/assets/logo.svg"
import SocialIcons from "@/components/SocialIcons.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE, SOCIALS } from "@/consts"
import { getPosts } from "@/lib/content"
import { normalizePath } from "@/lib/utils"

type Props = {
  crumbs?: { label: string; href: string }[]
  hasToc?: boolean
}

const { crumbs = [], hasToc = false } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)

// Inside the blog section, the sidebar lists every post (not just the open
// one), labeled by shortTitle where present.
const blogLinks = (await getPosts()).map(({ id, data }) => ({
  label: data.shortTitle ?? data.title,
  href: `/blog/${id}`,
}))
---

<aside data-bar>
  <sidebar-inner>
    <a href="/" aria-label={SITE.title}>
      <Logo />
      <span>{SITE.title}</span>
    </a>
    {hasToc && (
        <sidebar-toc>
          <slot name="toc" />
        </sidebar-toc>
      )}
    <nav>
      <ul>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={pathname === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item === section &&
                pathname !== item.href &&
                (item.href === "/blog" ? (
                  <ul>
                    {blogLinks.map((post) => (
                      <li>
                        <a
                          href={post.href}
                          aria-current={
                            pathname === post.href ||
                            pathname.startsWith(`${post.href}/`)
                              ? "page"
                              : undefined
                          }
                        >
                          {post.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  crumbs.length > 0 && (
                    <ul>
                      {crumbs.map((crumb, i) => (
                        <li data-depth={i ? 1 : undefined}>
                          <a
                            href={crumb.href}
                            aria-current={
                              i === crumbs.length - 1 ? "page" : undefined
                            }
                          >
                            {crumb.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )
                ))}
            </li>
          ))}
        {!section &&
            crumbs.map((crumb, i) => (
              <li data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
      </ul>
    </nav>
    <sidebar-socials>
      <SocialIcons links={SOCIALS} />
      <ThemeToggle />
    </sidebar-socials>
  </sidebar-inner>
  <sidebar-toggle>
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-height: 0;

    /* Fill the rail so the site nav can anchor to the bottom on every page
       (with or without a TOC above it) instead of shifting between pages. */
    @media (width >= 64rem) {
      flex: 1;

      > nav {
        margin-block-start: auto;
      }
    }

    > a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: fit-content;
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);
      color: var(--foreground);
      text-decoration-line: none;

      svg {
        inline-size: 1.125rem;
        block-size: 1.125rem;
        flex-shrink: 0;
      }

      @media (width < 26rem) {
        span {
          display: none;
        }
      }
    }

    @media (width < 64rem) {
      flex: 1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* The table of contents lives between the logo and the nav on wide
     screens; on the mobile header it wraps onto its own full-width row. */
  sidebar-toc {
    display: block;
    min-height: 0;
    margin-block: var(--space-s) var(--space-xs);

    @media (width < 64rem) {
      order: 99;
      flex-basis: 100%;
      margin-block: var(--space-2xs) calc(-1 * var(--space-2xs));
      padding-block-start: var(--space-2xs);
      border-block-start: 1px solid var(--border);
    }
  }

  sidebar-socials {
    display: flex;
    align-items: center;
    margin-block-start: var(--space-2xs);
    margin-inline-start: -0.5rem;

    /* In the mobile header the sidebar becomes a single row; the icon links
       would crowd the nav (they stay reachable in the footer), but the theme
       toggle rides along. */
    @media (width < 64rem) {
      margin-block-start: 0;
      margin-inline-start: 0;

      > :global(ul) {
        display: none;
      }
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      color: var(--muted-foreground);

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 64rem) {
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);

      ul {
        display: none;
      }
    }
  }

  nav li:has(> ul) > a {
    @media (width < 64rem) {
      color: var(--foreground);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 64rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
      /* Stay on the first header row when the TOC wraps onto a second one. */
      align-self: flex-start;
    }
  }
</style>
