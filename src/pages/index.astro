---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate } from "@/lib/utils"
import { getCollection, render } from "astro:content"

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const newsEntries = await Promise.all(
  news.map(async (entry) => ({
    ...entry,
    Content: (await render(entry)).Content,
  })),
)
---

<Layout>
  <MetaPage slot="head" />

  <intro-section>
    <h1>Yash Agarwal</h1>
    <!--
      TODO: write your intro here.

      A few sentences: who you are, what you work on, what you care about.
      Markdown is not processed in .astro files, so use plain HTML —
      <a href="...">links</a>, <em>italics</em>, <strong>bold</strong>.
    -->
    <prose-content>
      <p></p>
    </prose-content>
  </intro-section>

  {
    newsEntries.length > 0 && (
      <news-section>
        <h2>News</h2>
        <ul>
          {newsEntries.map(({ id, data, Content }) => (
            <li>
              <time datetime={data.date.toISOString()}>
                {formatDate(data.date)}
              </time>
              <news-body data-id={id}>
                <Content />
              </news-body>
            </li>
          ))}
        </ul>
      </news-section>
    )
  }
</Layout>

<style>
  intro-section {
    display: block;
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    prose-content {
      display: block;
      margin-block-start: var(--space-xs);
    }
  }

  news-section {
    display: block;
    margin-block-start: var(--space-l);

    h2 {
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-xs);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-2xs);
      list-style: none;
    }

    li {
      display: grid;
      grid-template-columns: 7.5rem 1fr;
      gap: var(--space-2xs);
      align-items: baseline;
      color: var(--muted-foreground);

      time {
        font-size: var(--step--1);
        color: color-mix(in oklab, var(--muted-foreground) 70%, transparent);
        font-variant-numeric: tabular-nums;
      }

      news-body :global(p) {
        margin: 0;
      }
    }

    @media (width < 40rem) {
      li {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }
  }
</style>
