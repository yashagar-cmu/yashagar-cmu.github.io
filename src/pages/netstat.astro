---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import body from "@/route-graph/page.html?raw"
import model from "@/route-graph/model.js?raw"
import ui from "@/route-graph/ui.js?raw"
import "@/route-graph/route-graph.css"

// Route Graph: paste netstat -rn, read the routing table as a graph. The tool
// lives in src/route-graph/ (see its README); this page only composes it. The
// two scripts share globals, so they ship as one inline script, not as modules.
const script = `${model}\n${ui}`
---

<Layout>
  <MetaPage
    slot="head"
    title="netstat"
    description="Paste any netstat -rn output (macOS, Linux, Windows) and read the routing table as a graph: interfaces, connected prefixes, next hops and neighbors, with decoded flags and a longest-prefix-match packet trace."
  />
  <Fragment set:html={body} />
  <script is:inline set:html={script} />
</Layout>

<style is:global>
  /* The graph wants room: on wide screens this page uses the whole content
     width instead of leaving the right columns empty. */
  @media (width >= 64rem) {
    page-content {
      grid-column: 3 / -1 !important;
    }
  }
</style>
