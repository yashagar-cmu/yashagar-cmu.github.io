---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import fragment from "@/components/RouteGraph.html?raw"
import "@/styles/route-graph.css"

// The page body, its samples and its script are generated by
// tools/routeviz_build.py in the courses-f26 repo (source: tools/routeviz_app/);
// edit there and rebuild rather than editing RouteGraph.html by hand.
---

<Layout>
  <MetaPage
    slot="head"
    title="netstat"
    description="Paste any netstat -rn output (macOS, Linux, Windows) and read the routing table as a graph: interfaces, connected prefixes, next hops and neighbors, with decoded flags and a longest-prefix-match packet trace."
  />
  <Fragment set:html={fragment} />
</Layout>

<style is:global>
  /* The graph wants room: on wide screens this page uses the whole content
     width instead of leaving the right columns empty. */
  @media (width >= 64rem) {
    page-content {
      grid-column: 3 / -1 !important;
    }
  }
</style>
